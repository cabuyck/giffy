# Giphy API Key (required)
# Get your key from: https://developers.giphy.com/
GIPHY_API_KEY=your_giphy_api_key_here

# Optional: Set to 'production' for production builds
NODE_ENV=production

# Optional: Custom port (defaults to 3001)
PORT=3001

# Optional: Client URL (only needed for CORS in dev mode)
# Leave unset for production (same-origin)
CLIENT_URL=http://localhost:5173
